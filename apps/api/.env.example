# =========================================================
# KADOSH POS API - EJEMPLO DE VARIABLES BACKEND
# Copia este archivo como .env para local.
# En Vercel, crea estas variables en Settings > Environment Variables.
# =========================================================

APP_NAME=Kadosh POS API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# LOCAL:
FRONTEND_URL=http://localhost:3000
# VERCEL:
# FRONTEND_URL=https://tu-frontend.vercel.app

# Usa siempre la misma URL de Supabase para conservar datos.
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/kadosh_pos_db
# Ejemplo Supabase:
# SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.xxxxx:password@aws-1-us-west-2.pooler.supabase.com:6543/postgres

JWT_SECRET_KEY=change_this_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CULQI_PUBLIC_KEY=pk_test_change_this
CULQI_SECRET_KEY=sk_test_change_this
CULQI_DEFAULT_PHONE_NUMBER=924454127

APIPERU_BASE_URL=https://apiperu.dev/api
APIPERU_TOKEN=change_this_apiperu_token

CUSTOMER_DISPLAY_DEVICE_ID=tablet-caja-01
CUSTOMER_DISPLAY_DEVICE_SECRET=change_this_customer_display_secret

# Gmail requiere App Password, no tu contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password-de-google
SMTP_FROM_EMAIL=tu-correo@gmail.com
SMTP_USE_TLS=true
